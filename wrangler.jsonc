/**
 * For more details on how to configure Wrangler, refer to:
 * https://developers.cloudflare.com/workers/wrangler/configuration/
 */
{
    "$schema": "node_modules/wrangler/config-schema.json",
    "name": "rock-paper-wrangler",
    "main": "src/index.ts",
    "compatibility_date": "2025-03-10",
    "compatibility_flags": [
        "nodejs_compat"
    ],
    "rules": [
        {
            "type": "Text",
            "globs": [
                "**/*.html",
                "**/public/static/*.css",
                "**/public/static/*.js"
            ],
            "fallthrough": false
        }
    ],
    "migrations": [
        {
            "new_sqlite_classes": [
                "MCP",
                "MatchmakerDurableObject",
                "LeaderboardDurableObject"
            ],
            "tag": "v1"
        },
    ],
    "durable_objects": {
        "bindings": [
            {
                "class_name": "MCP",
                "name": "MCP_OBJECT"
            },
            {
                "class_name": "MatchmakerDurableObject",
                "name": "MATCHMAKER_OBJECT"
            },
            {
                "class_name": "LeaderboardDurableObject",
                "name": "LEADERBOARD_OBJECT"
            }
        ]
    },
    "observability": {
        "enabled": true
    },
    "d1_databases": [
        {
            "binding": "DB",
            "database_name": "rock-paper-wrangler-db",
            "database_id": "befbc073-a315-4144-a0d3-ff99d2732489"
        }
    ],
    "kv_namespaces": [
        {
            "binding": "OAUTH_KV",
            "id": "preview_id"
        }
    ],
    // Production environment
    "env": {
        "production": {
            "durable_objects": {
                "bindings": [
                    {
                        "class_name": "MCP",
                        "name": "MCP_OBJECT"
                    },
                    {
                        "class_name": "MatchmakerDurableObject",
                        "name": "MATCHMAKER_OBJECT"
                    },
                    {
                        "class_name": "LeaderboardDurableObject",
                        "name": "LEADERBOARD_OBJECT"
                    }
                ]
            },
            "d1_databases": [
                {
                    "binding": "DB",
                    "database_name": "rock-paper-wrangler-db",
                    "database_id": "befbc073-a315-4144-a0d3-ff99d2732489"
                }
            ],
            "vars": {
                "ROCK_PAPER_CLANKER__ENVIRONMENT": "production",
                "ROCK_PAPER_CLANKER__MATCHMAKER__TIMEOUT": "60000", // 60 seconds for production
                "ROCK_PAPER_CLANKER__GAME_SERVICE__ROUND_POLL_INTERVAL": "1000",
                "ROCK_PAPER_CLANKER__GAME_SERVICE__ROUND_MAX_ATTEMPTS": "60",
                "ROCK_PAPER_CLANKER__GAME_SERVICE__WINNING_SCORE": "2"
            },
            "kv_namespaces": [
                {
                    "binding": "OAUTH_KV",
                    "id": "e34c57add0cc42688ac0afb29c468669"
                }
            ]
        }
    }
}