{
  "name": "rock-paper-wrangler",
  "version": "0.0.0",
  "private": true,
  "scripts": {
    "dev": "wrangler dev",
    "start": "wrangler dev",
    "deploy:prod": "wrangler deploy --env production",
    "test": "vitest run",
    "test:watch": "vitest",
    "format": "biome format --write",
    "lint:fix": "biome lint --fix",
    "lint": "biome lint",
    "generate": "wrangler types && npm run build:css && npm run build:static-packages",
    "type-check": "tsc --noEmit",
    "inspector": "npx -y @modelcontextprotocol/inspector@latest --config .mcp.json --server rock-paper-clanker",
    "db:generate": "drizzle-kit generate",
    "db:migrate:local": "for file in migrations/*.sql; do wrangler d1 execute rock-paper-wrangler-db --local --file=\"$file\"; done",
    "db:migrate:prod": "for file in migrations/*.sql; do wrangler d1 execute rock-paper-wrangler-db --remote --env production --file=\"$file\"; done",
    "db:reset:local": "rm -f .wrangler/state/v3/d1/miniflare-D1DatabaseObject/*.sqlite* && npm run db:migrate:local",
    "db:list-matches:local": "wrangler d1 execute rock-paper-wrangler-db --local --command=\"SELECT * FROM matches\"",
    "db:list-matches:prod": "wrangler d1 execute rock-paper-wrangler-db --env production --command=\"SELECT * FROM matches\"",
    "build:css": "tailwindcss -i src/input.css -o src/api/public/static/output.css --minify",
    "build:static-packages": "wget https://unpkg.com/htmx.org/dist/htmx.min.js -O ./src/api/public/static/htmx.min.js"
  },
  "dependencies": {
    "@cloudflare/workers-oauth-provider": "^0.1.0",
    "@modelcontextprotocol/sdk": "1.20.2",
    "agents": "^0.2.19",
    "drizzle-kit": "^0.31.6",
    "drizzle-orm": "^0.44.7",
    "hono": "^4.10.7",
    "itty-router": "^5.0.22",
    "mustache": "^4.2.0",
    "octokit": "^5.0.5",
    "zod": "^3.25.76"
  },
  "devDependencies": {
    "@biomejs/biome": "^2.3.2",
    "@tailwindcss/cli": "^4.1.17",
    "@types/mustache": "^4.2.6",
    "@types/node": "^24.10.0",
    "daisyui": "^5.5.5",
    "tailwindcss": "^4.1.17",
    "typescript": "5.9.3",
    "vitest": "^2.1.8",
    "wrangler": "^4.46.0"
  }
}
